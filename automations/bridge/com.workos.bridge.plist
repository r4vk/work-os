<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS autostart template. Replace BOTH /ABSOLUTE/PATH/TO/bridge occurrences.
     If your `claude` comes from nvm, prepend its bin dir to PATH below
     (e.g. /Users/you/.nvm/versions/node/vXX.Y.Z/bin) so launchd can find `node`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.workos.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/bridge/.venv/bin/python</string>
        <string>/ABSOLUTE/PATH/TO/bridge/slack_bridge.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/bridge</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/bridge/bridge.out.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/bridge/bridge.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
