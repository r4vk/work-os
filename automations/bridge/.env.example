# Copy to .env (same folder) and fill in. NEVER commit .env. NEVER paste tokens into chats.

# Slack app tokens (see SETUP.md step 1; create the app from slack-app-manifest.yml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Your Slack member ID (profile -> ... -> Copy member ID), e.g. U0123ABCD
ALLOWED_USER_ID=U...

# Vault location and personalization
VAULT_PATH=/absolute/path/to/your/vault
USER_NAME=Your Name
LANGUAGE=English

# Default brain: claude | local   (message prefix "c: ..." or "l: ..." overrides)
BRAIN=claude

# Claude Code CLI — under launchd/systemd ALWAYS use the full path (`which claude`)
CLAUDE_BIN=claude
CLAUDE_TIMEOUT=180

# Local LLM via LM Studio (Developer -> Start Server; OpenAI-compatible endpoint)
LOCAL_URL=http://localhost:1234/v1/chat/completions
LOCAL_MODEL=
LOCAL_TIMEOUT=120
